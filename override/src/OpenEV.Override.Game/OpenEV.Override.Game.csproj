<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>OpenEV.Override.Game</RootNamespace>
    <AssemblyName>OpenEV.Override</AssemblyName>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true' And '$(PublishSingleFileBundle)' != 'false'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <Target Name="StripPublishSideCarFiles" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish
        Remove="@(ResolvedFileToPublish)"
        Condition="'%(Extension)' == '.pdb' Or '%(Extension)' == '.lib' Or '%(Extension)' == '.exp'" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <PackageReference Include="Silk.NET.SDL" Version="2.23.0" />
    <PackageReference Include="NativeFileDialogSharp" Version="0.5.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Fonts\Grand9K-Pixel.ttf" />
    <EmbeddedResource Include="Fonts\Grand9K-9.bdf" />
    <EmbeddedResource Include="Fonts\ChicagoFLF.ttf" />
    <EmbeddedResource Include="Fonts\ChicagoFLF-12.bdf" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenEV.Override.Ports\OpenEV.Override.Ports.csproj" />
    <ProjectReference Include="..\..\..\platform\OpenEV.Platform.Toolbox\OpenEV.Platform.Toolbox.csproj" />
    <ProjectReference Include="..\..\..\platform\OpenEV.Platform.EvoData\OpenEV.Platform.EvoData.csproj" />
    <ProjectReference Include="..\..\..\platform\OpenEV.Platform.Imaging\OpenEV.Platform.Imaging.csproj" />
  </ItemGroup>
</Project>
