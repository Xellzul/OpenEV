<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OpenEV.Extraction.SitExtract</RootNamespace>
    <AssemblyName>OpenEV.Extraction.SitExtract</AssemblyName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true' And '$(PublishSingleFileBundle)' != 'false'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\platform\OpenEV.Platform.ResourceFork\OpenEV.Platform.ResourceFork.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenEV.Extraction.SitExtract.Tests" />
  </ItemGroup>
</Project>
