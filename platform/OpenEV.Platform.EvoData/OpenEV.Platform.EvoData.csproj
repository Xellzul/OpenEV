  <ItemGroup>
    <ProjectReference Include="..\OpenEV.Platform.ResourceFork\OpenEV.Platform.ResourceFork.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Settings inlined from the former src/Directory.Build.props (src/ removed 2026-06-04). -->
