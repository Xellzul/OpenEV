    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>OpenEV.Platform.EvoData</RootNamespace>
    <AssemblyName>OpenEV.Platform.EvoData</AssemblyName>
    <!-- CA2255: ModuleInit.cs uses [ModuleInitializer] intentionally (one-time
