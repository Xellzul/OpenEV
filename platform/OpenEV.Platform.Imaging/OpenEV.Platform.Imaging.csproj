<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Settings inlined from the former src/Directory.Build.props (src/ removed 2026-06-04). -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>OpenEV.Platform.Imaging</RootNamespace>
    <AssemblyName>OpenEV.Platform.Imaging</AssemblyName>
    <NoWarn>$(NoWarn);CS8618;CS8625;CS0219;CS0414;CS0168</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Portable (netstandard2.0, no graphics framework) glyph rasterizer for
         SoftwareFont. We use only the renderer-agnostic IFontSource side; the
         MonoGame-coupled FontStashSharp renderer is not referenced. -->
    <PackageReference Include="FontStashSharp.Base" Version="1.2.3" />
    <PackageReference Include="FontStashSharp.Rasterizers.StbTrueTypeSharp" Version="1.2.3" />
    <!-- A/B EVALUATION ONLY: FreeType's TrueType bytecode interpreter, to rasterize the
         Sillycon 14px HUD strike at runtime from the extracted sfnt (vs the bundled .bdf).
         Bundled native FreeType 2.13.2; only FreeTypeStrikeRasterizer.cs touches it. -->
    <PackageReference Include="FreeTypeSharp" Version="3.1.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenEV.Platform.EvoData\OpenEV.Platform.EvoData.csproj" />
  </ItemGroup>
</Project>
